{
  "name": "modbus-bridge",
  "version": "1.0.0",
  "description": "Local Modbus bridge for Fox ESS inverters (H1, H3, KH, and variants)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:telemetry && tsc",
    "build:telemetry": "tsc -p packages/modbus-telemetry/tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "probe": "node dist/probe.js",
    "pretest": "npm run build:telemetry",
    "pretest:integration": "npm run build:telemetry",
    "test": "vitest",
    "test:integration": "vitest --run src/**/*.integration.test.ts",
    "generate:profile-fixtures": "tsx scripts/generate-profile-fixtures.ts"
  },
  "dependencies": {
    "@checkmysolar/modbus-telemetry": "file:./packages/modbus-telemetry",
    "better-sqlite3": "^13.0.3",
    "luxon": "^3.7.2",
    "modbus-serial": "^8.0.23"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
